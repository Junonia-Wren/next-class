{
  "info": {
    "name": "NextClass - Auth + Admin + Schedule",
    "_postman_id": "c8f13ff0-9e55-4c92-af12-7b8c90801c77",
    "description": "Colección completa con rutas AUTH, ADMIN y SCHEDULE completamente refactorizadas.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },

  "variable": [
    {
      "key": "jwtToken",
      "value": ""
    }
  ],

  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register (Student)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"matricula\": \"20250001\",\n  \"name\": \"Juan Perez\",\n  \"password\": \"123456\",\n  \"group\": \"ID_DEL_GRUPO\"\n}"
            },
            "url": {
              "raw": "http://localhost:3000/api/auth/register",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "auth", "register"]
            }
          }
        },

        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let json = pm.response.json();",
                  "if (json.token) {",
                  "    pm.collectionVariables.set('jwtToken', json.token);",
                  "    console.log('Token guardado: ', json.token);",
                  "} else {",
                  "    console.log('No se recibió token.');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"matricula\": \"20250001\",\n  \"password\": \"123456\"\n}"
            },
            "url": {
              "raw": "http://localhost:3000/api/auth/login",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["api", "auth", "login"]
            }
          }
        }
      ]
    },

