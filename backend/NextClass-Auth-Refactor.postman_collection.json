      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "let json = pm.response.json();",
              "",
              "if (json.token) {",
              "    pm.collectionVariables.set(\"jwtToken\", json.token);",
              "    console.log(\"Token guardado\", json.token);",
              "} else {",
              "    console.log(\"No se recibió token.\");",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
